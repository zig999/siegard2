{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siegard.dev/schemas/node.json",
  "title": "Siegard node",
  "description": "One node of a domain analysis: the frontmatter of one markdown file under the knowledge root. The path is the identity — `context/<slug>.md` for a context, `<kind>/<context>/<slug>.md` for everything else — so no id, type or boundary field exists to disagree with it. `kind` is supplied by the validator from the path and is never written in a file; the examples omit it the same way. A fact the material does not state is declared absent by a `gaps` entry, never invented: the validator accepts a gap in place of any field its kind requires. One example per kind sits in that kind's branch. The body below the frontmatter carries exactly two headings, `## What it is` and `## Rules` — the second points at the rule nodes and declared constraints that govern the node, and holds no rule of its own.",
  "type": "object",
  "required": ["kind", "title", "summary"],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": ["context", "aggregate", "definition", "rule", "lifecycle", "interface", "process"],
      "description": "Supplied by the validator from the file path; never written in frontmatter."
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence saying what the node holds, not what kind it is."
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "description": "Why the analysis decided this. Present means the analysis decided; absent means the material stated it."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Where this node was read from — ordinarily files under the knowledge root's `intake/`, which the validator never reads."
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gap" },
      "description": "Facts this kind requires and the material does not state. A gap excuses the absence of the field it names; it never excuses form and never permits a forbidden field."
    },
    "strategic": {
      "enum": ["core", "supporting", "generic"],
      "description": "Where the business differs, where it is merely specific, and where the problem is already solved."
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/relationship" }
    },
    "ddd": {
      "enum": [
        "entity", "value-object", "aggregate-root", "read-model", "domain-error",
        "invariant", "policy", "specification",
        "domain-event", "integration-event", "command", "api",
        "domain-service", "saga", "use-case"
      ],
      "description": "The construct this node records. Narrowed to its own set inside each kind's branch."
    },
    "aggregate": {
      "$ref": "#/$defs/slug",
      "description": "The aggregate this node sits in, named by slug and resolved inside the node's own context — another context's aggregate is unnameable."
    },
    "identity": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attributeName" },
      "description": "Which attributes answer *which one*."
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Synonyms. Declared here and used nowhere else."
    },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attribute" }
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "description": "The rule in prose, one falsifiable condition."
    },
    "expression": {
      "type": "string",
      "minLength": 1,
      "description": "The rule stated so a consumer can evaluate it."
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Given/when/then cases a conformance test derives from."
    },
    "constrains": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nodeRef" },
      "description": "What this rule binds. A rule naming nothing leaves the relationship in prose."
    },
    "consistency": {
      "enum": ["immediate", "eventual"],
      "description": "Whether the rule holds inside one transaction or converges after it. Required by the validator where `constrains` reaches outside the rule's own aggregate."
    },
    "subject": {
      "$ref": "#/$defs/definitionRef",
      "description": "The definition whose states this governs. At most one lifecycle per definition."
    },
    "states": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stateName" }
    },
    "initial": { "$ref": "#/$defs/stateName" },
    "terminal": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stateName" },
      "description": "States that accept no further trigger. Declared, and exempt from the totality check because declared."
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transition" }
    },
    "rejections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rejection" },
      "description": "Decided non-transitions. Every pairing of a non-terminal state with a mentioned trigger is a transition, a rejection, or a gap naming `transitions.<state>.<trigger>` — the pairing the material left open. Only that three-segment form excuses a pairing from the totality check; a two-segment `transitions.<state>` records that the material names no way out of a state, and excuses nothing."
    },
    "ownership": {
      "enum": ["published", "consumed"],
      "description": "Whether this context exposes the interface or depends on someone else's."
    },
    "payload": {
      "$ref": "#/$defs/definitionRef",
      "description": "The definition that gives this interface its shape."
    },
    "upstream": {
      "$ref": "#/$defs/interfaceRef",
      "description": "The published interface this consumed one is a local record of."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "context" } }, "required": ["kind"] },
      "then": {
        "required": ["strategic"],
        "propertyNames": {
          "enum": ["kind", "title", "summary", "rationale", "sources", "gaps", "strategic", "relationships"]
        },
        "examples": [
          {
            "title": "Sales",
            "summary": "Ordering, from placement to invoicing.",
            "strategic": "core",
            "relationships": [
              { "with": "shipping", "pattern": "customer-supplier", "role": "upstream" }
            ]
          }
        ]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "aggregate" } }, "required": ["kind"] },
      "then": {
        "propertyNames": {
          "enum": ["kind", "title", "summary", "rationale", "sources", "gaps"]
        },
        "examples": [
          {
            "title": "Orders",
            "summary": "An order and its lines change together or not at all.",
            "rationale": "The material treats order lines as editable rows; making them part of one consistency boundary is the analysis's reading."
          }
        ]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "definition" } }, "required": ["kind"] },
      "then": {
        "required": ["ddd", "attributes"],
        "propertyNames": {
          "enum": ["kind", "title", "summary", "rationale", "sources", "gaps", "ddd", "aggregate", "identity", "aliases", "attributes"]
        },
        "properties": {
          "ddd": { "enum": ["entity", "value-object", "aggregate-root", "read-model", "domain-error"] }
        },
        "allOf": [
          {
            "if": { "properties": { "ddd": { "enum": ["entity", "aggregate-root", "read-model"] } }, "required": ["ddd"] },
            "then": { "required": ["identity"] }
          },
          {
            "if": { "properties": { "ddd": { "const": "aggregate-root" } }, "required": ["ddd"] },
            "then": { "required": ["aggregate"] }
          }
        ],
        "examples": [
          {
            "title": "Order",
            "summary": "A customer's order, from placement to invoicing.",
            "ddd": "aggregate-root",
            "aggregate": "orders",
            "identity": ["order_number"],
            "aliases": ["purchase-order"],
            "attributes": [
              { "name": "order_number", "type": "string", "max_length": 20, "required": true },
              { "name": "total", "type": "decimal", "precision": 12, "scale": 2 },
              { "name": "customer", "type": "ref", "target": "definition/sales/customer", "binding": "by-identity" },
              { "name": "state", "type": "enum", "lifecycle": "lifecycle/sales/order" }
            ]
          }
        ]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "rule" } }, "required": ["kind"] },
      "then": {
        "required": ["ddd", "statement"],
        "propertyNames": {
          "enum": ["kind", "title", "summary", "rationale", "sources", "gaps", "ddd", "aggregate", "statement", "expression", "examples", "constrains", "consistency"]
        },
        "properties": {
          "ddd": { "enum": ["invariant", "policy", "specification"] }
        },
        "examples": [
          {
            "title": "Order total is positive",
            "summary": "No order may be placed with a non-positive total.",
            "ddd": "invariant",
            "aggregate": "orders",
            "statement": "An order total MUST be greater than zero.",
            "expression": "order.total > 0",
            "constrains": ["definition/sales/order"]
          }
        ]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "lifecycle" } }, "required": ["kind"] },
      "then": {
        "required": ["subject", "states", "initial", "transitions"],
        "propertyNames": {
          "enum": ["kind", "title", "summary", "rationale", "sources", "gaps", "subject", "states", "initial", "terminal", "transitions", "rejections"]
        },
        "examples": [
          {
            "title": "Order lifecycle",
            "summary": "The states an order passes through, from draft to closure.",
            "subject": "definition/sales/order",
            "states": ["draft", "placed", "cancelled"],
            "initial": "draft",
            "terminal": ["cancelled"],
            "transitions": [
              { "from": "draft", "trigger": "place", "to": "placed", "emits": ["interface/sales/order-placed"] },
              { "from": "draft", "trigger": "cancel", "to": "cancelled" },
              { "from": "placed", "trigger": "cancel", "to": "cancelled" }
            ],
            "rejections": [
              { "from": "placed", "trigger": "place", "error": "definition/sales/order-already-placed" }
            ]
          }
        ]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "interface" } }, "required": ["kind"] },
      "then": {
        "required": ["ddd", "ownership"],
        "propertyNames": {
          "enum": ["kind", "title", "summary", "rationale", "sources", "gaps", "ddd", "ownership", "payload", "upstream"]
        },
        "properties": {
          "ddd": { "enum": ["domain-event", "integration-event", "command", "api"] }
        },
        "allOf": [
          {
            "if": { "properties": { "ddd": { "enum": ["domain-event", "integration-event", "command"] } }, "required": ["ddd"] },
            "then": { "required": ["payload"] }
          },
          {
            "if": { "properties": { "ownership": { "const": "consumed" } }, "required": ["ownership"] },
            "then": { "required": ["upstream"] }
          }
        ],
        "examples": [
          {
            "title": "Shipment requested",
            "summary": "The message this context sends to have an order shipped.",
            "ddd": "command",
            "ownership": "consumed",
            "payload": "definition/sales/shipment-request",
            "gaps": [
              { "field": "upstream", "why": "The material does not say which published contract of the shipping context this consumes." }
            ]
          }
        ]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "process" } }, "required": ["kind"] },
      "then": {
        "required": ["ddd", "steps"],
        "propertyNames": {
          "enum": ["kind", "title", "summary", "rationale", "sources", "gaps", "ddd", "steps"]
        },
        "properties": {
          "ddd": { "enum": ["domain-service", "saga", "use-case"] }
        },
        "examples": [
          {
            "title": "Checkout",
            "summary": "Place the order, charge the customer, compensate on failure.",
            "ddd": "saga",
            "steps": [
              { "node": "interface/sales/order-placed" },
              { "node": "process/payment/charge", "compensated_by": "process/payment/refund" }
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "A name reduced to kebab-case. A name that will not reduce is a refusal, not a transliteration."
    },
    "attributeName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "stateName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nodeRef": {
      "type": "string",
      "pattern": "^(context/[a-z0-9]+(-[a-z0-9]+)*|(aggregate|definition|rule|lifecycle|interface|process)/[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*)$",
      "description": "Any node, by identifier. The identifier is the file path without `.md`."
    },
    "definitionRef": {
      "type": "string",
      "pattern": "^definition/[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "interfaceRef": {
      "type": "string",
      "pattern": "^interface/[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "lifecycleRef": {
      "type": "string",
      "pattern": "^lifecycle/[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "gap": {
      "type": "object",
      "required": ["field", "why"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-z_]+(\\.[a-z0-9_.\\[\\]-]+)*$",
          "description": "The absent field, by name. A bare name is accepted only while the node does not declare the field; once the field is declared, an absence inside it takes a dotted path. Two canonical tails keep gaps comparable across analyses: `<field>.[]` says entries are missing whose names the material does not give, and `<field>.<label>` names the one missing thing."
        },
        "why": { "type": "string", "minLength": 1 }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["with", "pattern"],
      "additionalProperties": false,
      "properties": {
        "with": {
          "$ref": "#/$defs/slug",
          "description": "The other context, by slug."
        },
        "pattern": {
          "enum": ["anti-corruption-layer", "conformist", "customer-supplier", "open-host-service", "shared-kernel", "separate-ways", "partnership"]
        },
        "role": {
          "enum": ["upstream", "downstream"],
          "description": "What this context is relative to the one it names. Only a directional pattern has sides."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "pattern": { "enum": ["anti-corruption-layer", "conformist", "customer-supplier", "open-host-service"] } }, "required": ["pattern"] },
          "then": { "required": ["role"] }
        },
        {
          "if": { "properties": { "pattern": { "enum": ["shared-kernel", "separate-ways", "partnership"] } }, "required": ["pattern"] },
          "then": { "not": { "required": ["role"] } }
        }
      ]
    },
    "attribute": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/attributeName" },
        "type": {
          "enum": ["string", "integer", "decimal", "boolean", "date", "datetime", "enum", "ref", "list"]
        },
        "required": { "type": "boolean" },
        "max_length": { "type": "integer", "minimum": 1 },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "precision": { "type": "integer", "minimum": 1 },
        "scale": { "type": "integer", "minimum": 0 },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/slug" }
        },
        "lifecycle": { "$ref": "#/$defs/lifecycleRef" },
        "target": { "$ref": "#/$defs/definitionRef" },
        "of": { "$ref": "#/$defs/definitionRef" },
        "binding": { "enum": ["embedded", "by-identity"] },
        "min_items": { "type": "integer", "minimum": 0 },
        "max_items": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
          "then": {
            "oneOf": [
              { "required": ["values"], "not": { "required": ["lifecycle"] } },
              { "required": ["lifecycle"], "not": { "required": ["values"] } }
            ]
          }
        },
        {
          "if": { "properties": { "type": { "const": "ref" } }, "required": ["type"] },
          "then": { "required": ["target"] }
        },
        {
          "if": { "properties": { "type": { "const": "list" } }, "required": ["type"] },
          "then": { "required": ["of"] }
        }
      ]
    },
    "transition": {
      "type": "object",
      "required": ["from", "trigger", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/stateName" },
        "trigger": { "$ref": "#/$defs/slug" },
        "to": { "$ref": "#/$defs/stateName" },
        "emits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/interfaceRef" }
        }
      }
    },
    "rejection": {
      "type": "object",
      "required": ["from", "trigger"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/stateName" },
        "trigger": { "$ref": "#/$defs/slug" },
        "error": {
          "$ref": "#/$defs/definitionRef",
          "description": "The domain error this refusal surfaces. Absent only where a gap names `rejections.<from>.<trigger>.error` — a refusal the material states without naming what it raises."
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["node"],
      "additionalProperties": false,
      "properties": {
        "node": { "$ref": "#/$defs/nodeRef" },
        "compensated_by": { "$ref": "#/$defs/nodeRef" }
      }
    }
  }
}
