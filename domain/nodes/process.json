{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siegard.dev/domain/nodes/process.json",
  "title": "process node",
  "description": "An ordered path across the other kinds. A process names its steps in order and each step names a node already modelled; it does not restate what that node says. A process that restates its steps' content is a second copy of them, and the copy is the one that stops being maintained — which is why a step carries an identifier and nothing else.",
  "x-kind": "process",
  "x-ddd-vocabulary": "processDdd",
  "x-body-sections": [
    "## Answer",
    "## Outcomes"
  ],
  "x-edges-declared": [
    "boundary",
    "steps[].node",
    "steps[].compensated_by",
    "depends_on"
  ],
  "x-forbids": [],
  "x-composes": [
    "../tables/envelope.json",
    "../tables/identifiers.json",
    "../tables/vocabularies.json",
    "../tables/edges.json",
    "../tables/body-sections.json",
    "../tables/invariants.json"
  ],
  "type": "object",
  "properties": {
    "ddd": {
      "$ref": "../tables/vocabularies.json#/$defs/processDdd"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "The ordered steps, each naming exactly one node.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node"
        ],
        "properties": {
          "node": {
            "$ref": "../tables/identifiers.json#/$defs/nodeId"
          },
          "compensated_by": {
            "$ref": "../tables/identifiers.json#/$defs/nodeId",
            "description": "What undoes this step when a later one fails. A saga is defined by its compensations, and a step carrying only an identifier cannot hold one — so `saga` named a construct the structure could not represent."
          }
        }
      }
    }
  },
  "x-alternation": "Every field this kind requires is alternated separately against a gap naming that field, so a gap about one fact never excuses the absence of another. The shape is stated once in `../tables/invariants.json#/x-gap-alternation`. A prohibition is not excused: a gap says a fact is absent and cannot make a forbidden field allowed.",
  "x-open": [
    "`domain-object/1` spells the step's field `ko`. It is `node` here, and the rename is a breaking change to the frontmatter contract."
  ],
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "boundary"
          ]
        },
        {
          "required": [
            "gaps"
          ],
          "properties": {
            "gaps": {
              "contains": {
                "required": [
                  "field"
                ],
                "properties": {
                  "field": {
                    "const": "boundary"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "ddd"
          ]
        },
        {
          "required": [
            "gaps"
          ],
          "properties": {
            "gaps": {
              "contains": {
                "required": [
                  "field"
                ],
                "properties": {
                  "field": {
                    "const": "ddd"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "steps"
          ]
        },
        {
          "required": [
            "gaps"
          ],
          "properties": {
            "gaps": {
              "contains": {
                "required": [
                  "field"
                ],
                "properties": {
                  "field": {
                    "const": "steps"
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}
