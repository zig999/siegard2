{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siegard.dev/domain/nodes/interface.json",
  "title": "interface node",
  "description": "What a context publishes or consumes. A `domain-event` is something that happened inside a context, named in the past tense; an `integration-event` crosses a context boundary and is therefore a published contract someone else depends on; a `published-language` is a shared vocabulary for exchange; an `api` is an exposed operation.\n\nWhether the context publishes or consumes decides who owes whom compatibility. A break requires a version bump and a migration, from which a consumed interface is exempt.\n\nAn interface is also the only target a reference crossing a bounded context may name.",
  "x-kind": "interface",
  "x-ddd-vocabulary": "interfaceDdd",
  "x-body-sections": [
    "## Answer",
    "## Semantics"
  ],
  "x-edges-declared": [
    "boundary",
    "payload",
    "upstream",
    "depends_on"
  ],
  "x-forbids": [],
  "x-composes": [
    "../tables/envelope.json",
    "../tables/identifiers.json",
    "../tables/vocabularies.json",
    "../tables/edges.json",
    "../tables/body-sections.json",
    "../tables/invariants.json"
  ],
  "type": "object",
  "properties": {
    "ddd": {
      "$ref": "../tables/vocabularies.json#/$defs/interfaceDdd"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "type": "string",
      "minLength": 1,
      "description": "Where the machine-readable payload contract lives. The form of this value is not closed."
    },
    "ownership": {
      "$ref": "../tables/vocabularies.json#/$defs/ownership"
    },
    "payload": {
      "$ref": "../tables/identifiers.json#/$defs/definitionId",
      "description": "The definition that gives this interface its shape. One home for the payload's type, in the same vocabulary every other typed thing uses — an event whose fields live only in an external file is a contract the graph cannot read. `schema` still points at the wire contract, which is stack knowledge."
    },
    "upstream": {
      "$ref": "../tables/identifiers.json#/$defs/interfaceId",
      "description": "The published interface this one consumes. A consumed interface is a local record of somebody else's contract, so without this the graph holds two nodes for one contract and cannot tell they are the same one. The consumer declares it; the publisher never enumerates who depends on it, for the reason a scope never enumerates what it holds."
    }
  },
  "x-alternation": "Every field this kind requires is alternated separately against a gap naming that field, so a gap about one fact never excuses the absence of another. The shape is stated once in `../tables/invariants.json#/x-gap-alternation`. A prohibition is not excused: a gap says a fact is absent and cannot make a forbidden field allowed.",
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "boundary"
          ]
        },
        {
          "required": [
            "gaps"
          ],
          "properties": {
            "gaps": {
              "contains": {
                "required": [
                  "field"
                ],
                "properties": {
                  "field": {
                    "const": "boundary"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "ddd"
          ]
        },
        {
          "required": [
            "gaps"
          ],
          "properties": {
            "gaps": {
              "contains": {
                "required": [
                  "field"
                ],
                "properties": {
                  "field": {
                    "const": "ddd"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "version"
          ]
        },
        {
          "required": [
            "gaps"
          ],
          "properties": {
            "gaps": {
              "contains": {
                "required": [
                  "field"
                ],
                "properties": {
                  "field": {
                    "const": "version"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "schema"
          ]
        },
        {
          "required": [
            "gaps"
          ],
          "properties": {
            "gaps": {
              "contains": {
                "required": [
                  "field"
                ],
                "properties": {
                  "field": {
                    "const": "schema"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "ownership"
          ]
        },
        {
          "required": [
            "gaps"
          ],
          "properties": {
            "gaps": {
              "contains": {
                "required": [
                  "field"
                ],
                "properties": {
                  "field": {
                    "const": "ownership"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "ddd": {
            "enum": [
              "domain-event",
              "integration-event",
              "published-language",
              "command"
            ]
          }
        },
        "required": [
          "ddd"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "payload"
            ]
          },
          {
            "required": [
              "gaps"
            ],
            "properties": {
              "gaps": {
                "contains": {
                  "required": [
                    "field"
                  ],
                  "properties": {
                    "field": {
                      "const": "payload"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "description": "A message or a shared vocabulary carries a shape. An `api` is an exposed operation and names none here."
    },
    {
      "if": {
        "properties": {
          "ownership": {
            "const": "consumed"
          }
        },
        "required": [
          "ownership"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "upstream"
            ]
          },
          {
            "required": [
              "gaps"
            ],
            "properties": {
              "gaps": {
                "contains": {
                  "required": [
                    "field"
                  ],
                  "properties": {
                    "field": {
                      "const": "upstream"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "else": {
        "not": {
          "required": [
            "upstream"
          ]
        }
      },
      "description": "Only a consumed interface names what it consumes. `upstream` on a published one would say this context both owns the contract and depends on someone else's."
    }
  ]
}
