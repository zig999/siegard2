{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siegard.dev/domain/tables/primitives.json",
  "title": "Attribute primitives",
  "description": "The closed attribute type system. A parameter that changes what is produced is required; a parameter the primitive does not read is rejected rather than carried as dead representation.\n\nA free-text type is refused. The vocabulary is closed at twelve, and a thirteenth arrives with a construct that needs it rather than for symmetry.\n\n**Which parameter each primitive requires is stated once, in `$defs.attribute`, and nowhere else in this file.** It was previously stated twice — a readable table beside the assertions that enforce them — and two homes for one fact is two facts as soon as one is edited. What the assertions cannot express is carried below, and only that.",
  "x-inherits": {
    "note": "Two primitives take a value from the base's own declaration rather than from an attribute, so the parameter is optional here and absent means inherited rather than unstated. This is the fact `$defs.attribute` cannot express: a schema can say the key is optional and cannot say what fills it when it is missing.",
    "source": "src/claude/schemas/knowledge-system.json",
    "money.currency": "defaults.currency",
    "datetime.timezone": "defaults.timezone",
    "overridden": "only where an attribute genuinely differs from the base's default"
  },
  "x-unstated-parameter": {
    "rule": "A required parameter the material does not state is declared absent **and named by a gap** — `attributes[<name>].<parameter>` — never chosen and never silently omitted.",
    "why": "The two readings that are not this one both fail. Choosing a length invents a domain fact and it reads exactly like one the business stated. Omitting it silently produces an attribute nothing can generate from, and no record of why.",
    "decided_by": "src/claude/bin/check_knowledge.py missing_parameters()",
    "note": "`text` is the primitive for a string the domain genuinely does not bound. Reaching for `string` with a gap where `text` is meant records an open question that is not open."
  },
  "$defs": {
    "attribute": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "identifiers.json#/$defs/attributeName"
        },
        "type": {
          "enum": [
            "string",
            "text",
            "integer",
            "decimal",
            "money",
            "boolean",
            "date",
            "datetime",
            "duration",
            "enum",
            "ref",
            "list"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "max_length"
            ],
            "properties": {
              "max_length": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "integer"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "min": {
                "type": "integer"
              },
              "max": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "decimal"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "precision",
              "scale"
            ],
            "properties": {
              "precision": {
                "type": "integer",
                "minimum": 1
              },
              "scale": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "money"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "datetime"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "timezone": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "description": "A lifecycle-bound enum keeps the state set in one authority. A free enum lists its own values.",
            "oneOf": [
              {
                "required": [
                  "lifecycle"
                ],
                "not": {
                  "required": [
                    "values"
                  ]
                },
                "properties": {
                  "lifecycle": {
                    "$ref": "identifiers.json#/$defs/lifecycleId"
                  }
                }
              },
              {
                "required": [
                  "values"
                ],
                "not": {
                  "required": [
                    "lifecycle"
                  ]
                },
                "properties": {
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "identifiers.json#/$defs/slug"
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ref"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "target",
              "binding"
            ],
            "properties": {
              "target": {
                "$ref": "identifiers.json#/$defs/definitionId"
              },
              "binding": {
                "$ref": "vocabularies.json#/$defs/binding"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "of",
              "binding"
            ],
            "properties": {
              "of": {
                "$ref": "identifiers.json#/$defs/definitionId"
              },
              "binding": {
                "$ref": "vocabularies.json#/$defs/binding"
              },
              "min_items": {
                "type": "integer",
                "minimum": 0
              },
              "max_items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
